<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<inceptionYear>2026</inceptionYear>
	<url>https://github.com/PabloAbreu/brts</url>
	<organization>
		<name>Pablo ABREU</name>
		<url>https://github.com/PabloAbreu/</url>
	</organization>

	<groupId>org.brts</groupId>
	<artifactId>brts-parent</artifactId>
	<version>0.0.2-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>BRTS - Blu-ray Tools Suite</name>
	<description>
		A suite of tools to author Blu-rays: generate compliant Blu-ray folder
		structures
		with all needed files from MKV sources and structured descriptors.
	</description>

	<modules>
		<module>brts-common</module>
		<module>brts-low-level</module>
		<module>brts-middle-level</module>
		<module>brts-high-level</module>
		<module>brts-cli</module>
		<module>brts-doc-parser</module>
		<module>brts-doc-generator</module>
	</modules>

	<properties>
		<license.licenseName>lgpl_v3</license.licenseName>
		<java.version>21</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<test.samples.dir>${maven.multiModuleProjectDirectory}/samples</test.samples.dir>

		<!-- Dependency versions -->
		<jackson.version>2.17.2</jackson.version>
		<args4j.version>2.37</args4j.version>
		<slf4j.version>2.0.13</slf4j.version>
		<logback.version>1.5.6</logback.version>
		<ebml-java.version>1.0.0</ebml-java.version>
		<junit.version>5.11.0</junit.version>
		<mockito.version>5.12.0</mockito.version>
		<assertj.version>3.26.3</assertj.version>
		<ffmpeg.version>8.0.1-1.5.13</ffmpeg.version>
		<ffmpeg.platform>linux-x86_64</ffmpeg.platform>
		<opencv.version>4.13.0-1.5.13</opencv.version>
		<opencv.platform>linux-x86_64</opencv.platform>
		<batik.version>1.18</batik.version>
		<freemarker.version>2.3.34</freemarker.version>
		<jakarta.validation.version>3.1.0</jakarta.validation.version>
		<hibernate-validator.version>9.0.0.Final</hibernate-validator.version>

		<!-- Plugin versions -->
		<maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.3.1</maven-surefire-plugin.version>
		<maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
		<maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
		<maven-pmd-plugin.version>3.26.0</maven-pmd-plugin.version>
	</properties>

	<!-- TODO upload jebml to maven central 
	 	and get rid of this -->
	<repositories>
		<repository>
			<id>github-jebml</id>
			<name>GitHub Packages - BRTS jebml</name>
			<url>https://maven.pkg.github.com/PabloAbreu/jebml</url>
		</repository>
	</repositories>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules -->
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-low-level</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-middle-level</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-high-level</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-cli</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>brts-doc-parser</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- JSON (Jackson) -->
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-core</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<version>${jackson.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.datatype</groupId>
				<artifactId>jackson-datatype-jdk8</artifactId>
				<version>${jackson.version}</version>
			</dependency>

			<!-- CLI argument parsing -->
			<dependency>
				<groupId>args4j</groupId>
				<artifactId>args4j</artifactId>
				<version>${args4j.version}</version>
			</dependency>

			<!-- Logging -->
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
			<dependency>
				<groupId>ch.qos.logback</groupId>
				<artifactId>logback-classic</artifactId>
				<version>${logback.version}</version>
			</dependency>

			<!-- MKV / EBML parsing -->
			<dependency>
				<groupId>org.brts</groupId>
				<artifactId>jebml</artifactId>
				<version>2.4.0</version>
			</dependency>

			<dependency>
				<groupId>org.bytedeco</groupId>
				<artifactId>ffmpeg</artifactId>
				<version>${ffmpeg.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bytedeco</groupId>
				<artifactId>ffmpeg</artifactId>
				<version>${ffmpeg.version}</version>
				<classifier>${ffmpeg.platform}</classifier>
			</dependency>
			<dependency>
				<groupId>org.bytedeco</groupId>
				<artifactId>opencv</artifactId>
				<version>${opencv.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bytedeco</groupId>
				<artifactId>opencv</artifactId>
				<version>${opencv.version}</version>
				<classifier>${opencv.platform}</classifier>
			</dependency>

			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>1.18.38</version>
				<scope>provided</scope>
			</dependency>

			<!-- SVG rendering (Apache Batik) -->
			<dependency>
				<groupId>org.apache.xmlgraphics</groupId>
				<artifactId>batik-transcoder</artifactId>
				<version>${batik.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.xmlgraphics</groupId>
				<artifactId>batik-codec</artifactId>
				<version>${batik.version}</version>
			</dependency>

			<!-- Templating (FreeMarker) -->
			<dependency>
				<groupId>org.freemarker</groupId>
				<artifactId>freemarker</artifactId>
				<version>${freemarker.version}</version>
			</dependency>

			<!-- Bean Validation (descriptor / CLI options validation) -->
			<dependency>
				<groupId>jakarta.validation</groupId>
				<artifactId>jakarta.validation-api</artifactId>
				<version>${jakarta.validation.version}</version>
			</dependency>
			<dependency>
				<groupId>org.hibernate.validator</groupId>
				<artifactId>hibernate-validator</artifactId>
				<version>${hibernate-validator.version}</version>
			</dependency>

			<!-- Testing -->
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>${assertj.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- Dependencies inherited by all modules -->
	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${java.version}</release>
						<showWarnings>true</showWarnings>
						<showDeprecation>true</showDeprecation>
						<compilerArgs>
							<arg>-Xlint:all,-serial</arg>
						</compilerArgs>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>1.18.46</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<systemPropertyVariables>
							<test.samples.dir>${test.samples.dir}</test.samples.dir>
						</systemPropertyVariables>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>${maven-assembly-plugin.version}</version>
				</plugin>
				<plugin>
					<!-- Not bound to any lifecycle phase; run on demand with
					`mvn pmd:pmd` (or `mvn pmd:check` to fail the build on
					violations, or `mvn pmd:aggregate-pmd` from the parent for
					a single multi-module report) -->
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<configuration>
						<targetJdk>${java.version}</targetJdk>
						<linkXRef>false</linkXRef>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
				<version>2.29.0</version>
				<configuration>
					<configFile>${maven.multiModuleProjectDirectory}/config/brts-java-formatter.xml</configFile>
					<encoding>UTF-8</encoding>
					<lineEnding>LF</lineEnding>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>format</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>2.7.1</version>
				<configuration>
					<descriptionTemplate>${maven.multiModuleProjectDirectory}/config/license-header.txt</descriptionTemplate>
					<encoding>UTF-8</encoding>
					<processStartTag> ===_LICENSE_BEGIN_=== </processStartTag>
					<sectionDelimiter>==============================</sectionDelimiter>
					<processEndTag> ===_LICENSE_END_=== </processEndTag>
				</configuration>
				<executions>
					<execution>
						<id>add-license-headers</id>
						<phase>process-sources</phase>
						<goals>
							<goal>update-file-header</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/*.java</include>
							</includes>
							<licenseName>lgpl_v3</licenseName>
							<roots>
								<root>src/main/java</root>
								<root>src/test/java</root>
							</roots>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<testResources>
			<testResource>
				<directory>${maven.multiModuleProjectDirectory}/config</directory>
				<includes>
					<include>logback-test.xml</include>
				</includes>
			</testResource>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
		</testResources>
	</build>
</project>