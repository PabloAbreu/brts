<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.brts</groupId>
		<artifactId>brts-parent</artifactId>
		<version>0.0.2-SNAPSHOT</version>
	</parent>

	<artifactId>brts-doc-parser</artifactId>
	<name>BRTS - CLI Documentation Metadata Parser</name>

	<dependencies>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-cli</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>generate-cli-metadata</id>
						<phase>prepare-package</phase>
						<goals><goal>java</goal></goals>
						<configuration>
							<mainClass>org.brts.doc.parser.CliMetadataParserMain</mainClass>
							<arguments>
								<argument>--version</argument><argument>${project.version}</argument>
								<argument>--output</argument><argument>${project.build.directory}/generated-metadata/cli-metadata.json</argument>
								<argument>--source-root</argument><argument>${maven.multiModuleProjectDirectory}/brts-common/src/main/java</argument>
								<argument>--source-root</argument><argument>${maven.multiModuleProjectDirectory}/brts-low-level/src/main/java</argument>
								<argument>--source-root</argument><argument>${maven.multiModuleProjectDirectory}/brts-middle-level/src/main/java</argument>
								<argument>--source-root</argument><argument>${maven.multiModuleProjectDirectory}/brts-high-level/src/main/java</argument>
								<argument>--source-root</argument><argument>${maven.multiModuleProjectDirectory}/brts-cli/src/main/java</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>attach-cli-metadata</id>
						<phase>package</phase>
						<goals><goal>attach-artifact</goal></goals>
						<configuration>
							<artifacts><artifact>
								<file>${project.build.directory}/generated-metadata/cli-metadata.json</file>
								<type>json</type><classifier>cli-metadata</classifier>
							</artifact></artifacts>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>embed-cli-metadata</id>
						<phase>prepare-package</phase>
						<goals><goal>copy-resources</goal></goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/META-INF/brts</outputDirectory>
							<resources><resource>
								<directory>${project.build.directory}/generated-metadata</directory>
								<includes><include>cli-metadata.json</include></includes>
							</resource></resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>