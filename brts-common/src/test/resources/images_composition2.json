{
    "constants": {
        "menu_x": 1400
    },
    "baseImageId" : "video",
    "images": [
        {
            "imageId": "video",
            "videoPath": "samples/PB/BDMV/STREAM/00617.m2ts"
        },
        {
            "imageId": "im2",
            "sourcePath": "brts-common/src/test/resources/rectangle.jpg"
        },
        {
            "imageId": "credits",
            "syntheticImage": {
                "type": "svg",
                "srcPath" : "/data/work/brts/test_output/credits.svg"
            }
        }
    ],
    "compositions": [ {
        "imageId": "im2", 
