        "opacity": 0.6,
        "rotation": {
            "angle": "${frameNumber * 0.3}"
        }
    },{
        "imageId": "im2",
        "topLeft" : { "x": "${menu_x}", "y": 800 },
        "opacity": 0.6,
        "rotation": {
            "angle": "${frameNumber * 0.45}"
        }
    },{
        "imageId": "credits",
        "topLeft" : { "x": 200, "y": 200 },
        "opacity": 1,
        "crop" : { "topLeft": { "x": 500, "y": "${frameNumber * 3}" }, "size": { "width": 920, "height": 680 } }
    }
]
