{
  "name": "sober-dark",
  "description": "Minimal black menus with discreet square grey frames, white type and a selected-only yellow underline.",
  "style": {
    "fontName": "SansSerif",
    "fallbackFontName": "Dialog",
    "fontSize": 28,
    "fontStyle": 1,
    "normalColor": "#FFFFFF",
    "selectedColor": "#FFFFFF",
    "activatedColor": "#FFFFFF",
    "shadow": false,
    "outline": false,
    "backgroundShape": "NONE",
    "paddingX": 18,
    "paddingY": 12,
    "stateOverlays": {
      "selected": {
        "syntheticImage": {
          "type": "svg",
          "data": "<#if textWidth gt 0><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${width}\" height=\"${height}\" viewBox=\"0 0 ${width} ${height}\"><rect x=\"${textX}\" y=\"${textY + 4}\" width=\"${textWidth}\" height=\"3\" fill=\"#FFD400\"/></svg><#else><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${width}\" height=\"${height}\"/></#if>"
        }
      }
    }
  },
  "titleMenu": {
    "layoutType": "TEXT_LIST",
    "boundingBox": { "x": 180, "y": 220, "width": 800, "height": 640 },
    "style": { "fontSize": 34 },
    "backgroundSource": {
      "composition": {
        "canvasWidth": 1920,
        "canvasHeight": 1080,
        "baseImageId": "background",
        "images": [
          {
            "imageId": "background",
            "syntheticImage": { "type": "svg", "srcPath": "screen-background.svg", "frameRate": 24 }
          }
        ],
        "compositions": []
      },
      "durationSeconds": 30
    }
  },
  "popupMenu": {
    "layout": "HORIZONTAL_BOTTOM",
    "screenWidth": 1920,
    "screenHeight": 1080,
    "style": { "fontSize": 26 },
    "backgrounds": {
      "shared": [
        {
          "source": { "syntheticImage": { "type": "svg", "srcPath": "popup-menu-banner.svg.ftl" } },
          "layout": { "mode": "FULL_WIDTH_BOTTOM", "height": 220, "edgeOffset": 20, "marginLeft": 40, "marginRight": 40 }
        }
      ],
      "audio": [
        {
          "source": { "syntheticImage": { "type": "svg", "srcPath": "popup-panel-card.svg.ftl" } },
          "layout": { "mode": "SELECTABLE_BOUNDS", "marginTop": 16, "marginRight": 24, "marginBottom": 16, "marginLeft": 24 }
        }
      ],
      "subtitles": [
        {
          "source": { "syntheticImage": { "type": "svg", "srcPath": "popup-panel-card.svg.ftl" } },
          "layout": { "mode": "SELECTABLE_BOUNDS", "marginTop": 16, "marginRight": 24, "marginBottom": 16, "marginLeft": 24 }
        }
      ]
    }
  }
}
