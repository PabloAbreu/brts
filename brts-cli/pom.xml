<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.brts</groupId>
		<artifactId>brts-parent</artifactId>
		<version>0.0.2</version>
	</parent>

	<artifactId>brts-cli</artifactId>
	<name>BRTS - CLI</name>
	<description>
		Command-line entry points for all levels of the BRTStoolchain.
		Each subcommand is an independently launchable main class.
	</description>

	<dependencies>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-high-level</artifactId>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-middle-level</artifactId>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-low-level</artifactId>
		</dependency>
		<dependency>
			<groupId>args4j</groupId>
			<artifactId>args4j</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-common</artifactId>
			<classifier>tests</classifier>
			<type>test-jar</type>
			<scope>test</scope>
			<version>0.0.2</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Build a fat JAR with all dependencies so CLI can be run
			standalone -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>org.brts.cli.BrtsMain</mainClass>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<finalName>brts-cli</finalName>
					<appendAssemblyId>false</appendAssemblyId>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>