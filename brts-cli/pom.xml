<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.brts</groupId>
		<artifactId>brts-parent</artifactId>
		<version>0.0.3-SNAPSHOT</version>
	</parent>

	<artifactId>brts-cli</artifactId>
	<name>BRTS - CLI</name>
	<description>
		Command-line entry points for all levels of the BRTStoolchain.
		Each subcommand is an independently launchable main class.
	</description>

	<properties>
		<brts.launcher>brts</brts.launcher>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-high-level</artifactId>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-middle-level</artifactId>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-low-level</artifactId>
		</dependency>
		<dependency>
			<groupId>args4j</groupId>
			<artifactId>args4j</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.brts</groupId>
			<artifactId>brts-common</artifactId>
			<classifier>tests</classifier>
			<type>test-jar</type>
			<scope>test</scope>
			<version>0.0.3-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>validate-platform</id>
						<phase>validate</phase>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireProperty>
									<property>javacpp.platform</property>
									<regex>^(linux-x86_64(-gpl)?|windows-x86_64|macosx-(x86_64|arm64))$</regex>
									<regexMessage>Unsupported javacpp.platform. Supported classifiers: linux-x86_64, linux-x86_64-gpl, windows-x86_64, macosx-x86_64, macosx-arm64.</regexMessage>
								</requireProperty>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>default-jar</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>package-fat-jar</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<archive>
								<manifest>
									<mainClass>org.brts.cli.BrtsMain</mainClass>
									<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
								</manifest>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<finalName>brts-cli-${javacpp.platform}</finalName>
							<appendAssemblyId>false</appendAssemblyId>
						</configuration>
					</execution>
					<execution>
						<id>package-platform-distribution</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<descriptors>
								<descriptor>src/assembly/platform-distribution.xml</descriptor>
							</descriptors>
							<finalName>brts-${project.version}-${javacpp.platform}</finalName>
							<appendAssemblyId>false</appendAssemblyId>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>windows-host-launcher</id>
			<activation>
				<os>
					<family>Windows</family>
				</os>
			</activation>
			<properties>
				<brts.launcher>brts.bat</brts.launcher>
			</properties>
		</profile>
		<profile>
			<id>windows-target-launcher</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>windows-x86_64</value>
				</property>
			</activation>
			<properties>
				<brts.launcher>brts.bat</brts.launcher>
			</properties>
		</profile>
		<profile>
			<id>unix-target-launcher</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-x86_64</value>
				</property>
			</activation>
			<properties>
				<brts.launcher>brts</brts.launcher>
			</properties>
		</profile>
		<profile>
			<id>linux-gpl-target-launcher</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>linux-x86_64-gpl</value>
				</property>
			</activation>
			<properties>
				<brts.launcher>brts</brts.launcher>
			</properties>
		</profile>
		<profile>
			<id>macos-target-launcher</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>macosx-x86_64</value>
				</property>
			</activation>
			<properties>
				<brts.launcher>brts</brts.launcher>
			</properties>
		</profile>
		<profile>
			<id>apple-silicon-target-launcher</id>
			<activation>
				<property>
					<name>javacpp.platform</name>
					<value>macosx-arm64</value>
				</property>
			</activation>
			<properties>
				<brts.launcher>brts</brts.launcher>
			</properties>
		</profile>
	</profiles>
</project>